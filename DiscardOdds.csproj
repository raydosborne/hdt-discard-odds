<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Discard Odds: HDT plugin, milestone M0 (probe/test build).
    Build:  dotnet build -c Release -p:HdtDir="C:\path\to\folder\containing\HearthstoneDeckTracker.exe"
    HDT assemblies are referenced at build time only (Private=false) and are NEVER copied to the output.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>DiscardOdds</AssemblyName>
    <RootNamespace>DiscardOdds</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Ray Osborne</Authors>
    <Product>Discard Odds (M0 probe)</Product>
    <Copyright>Copyright (c) 2026 Ray Osborne. MIT License.</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Lets the SDK build net472 on machines without the .NET Framework 4.7.2 Developer Pack (and on Linux). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Where HDT lives. Override with -p:HdtDir=... ; default is ./lib/hdt (copy the DLLs there, it is gitignored). -->
  <PropertyGroup>
    <HdtDir Condition="'$(HdtDir)' == ''">$(MSBuildThisFileDirectory)lib\hdt</HdtDir>
    <!-- Squirrel installs name the exe HearthstoneDeckTracker.exe; the portable GitHub zip names it "Hearthstone Deck Tracker.exe". Same assembly. -->
    <HdtExe Condition="'$(HdtExe)' == '' And Exists('$(HdtDir)\HearthstoneDeckTracker.exe')">$(HdtDir)\HearthstoneDeckTracker.exe</HdtExe>
    <HdtExe Condition="'$(HdtExe)' == '' And Exists('$(HdtDir)\Hearthstone Deck Tracker.exe')">$(HdtDir)\Hearthstone Deck Tracker.exe</HdtExe>
    <!-- Optional: -p:DeployToHdt=true copies the DLL into %AppData%\HearthstoneDeckTracker\Plugins\DiscardOdds after build (Windows only). -->
    <HdtPluginDir>$(APPDATA)\HearthstoneDeckTracker\Plugins\DiscardOdds</HdtPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- the platform-free test project lives in tests/ and builds separately -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtExe)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckHdtReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(HdtExe)' == ''" Text="HearthstoneDeckTracker.exe not found in HdtDir='$(HdtDir)'. Pass -p:HdtDir=&quot;C:\Users\YOU\AppData\Local\HearthstoneDeckTracker\app-X.Y.Z&quot; (see README)." />
    <Error Condition="!Exists('$(HdtDir)\HearthDb.dll')" Text="HearthDb.dll not found in HdtDir='$(HdtDir)'." />
  </Target>

  <Target Name="DeployToHdtPlugins" AfterTargets="Build" Condition="'$(DeployToHdt)' == 'true' And '$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(HdtPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HdtPluginDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(HdtPluginDir). Restart HDT to load it." />
  </Target>
</Project>
